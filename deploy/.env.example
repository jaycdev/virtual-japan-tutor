# Copy to .env next to docker-compose.yml and adjust. Never commit real secrets.
# (Every variable here is optional except SECRETS_KEY.)

# Image version compose pulls: latest (newest release, default), dev (newest commit on main)
# or an exact release such as 1.2.3.
VJT_VERSION=latest

# --- Required ---
# Base64 of 32 random bytes, used to encrypt stored secrets (your MaruMori and AI Provider keys).
# Generate one with:  openssl rand -base64 32
# Back it up: losing or changing it makes already-stored secrets unreadable.
SECRETS_KEY=

# --- First account ---
# Created on first boot, only while there are NO users (set both; password >= 10 characters).
# Remove the password from this file once the account exists.
VJT_BOOTSTRAP_USERNAME=
VJT_BOOTSTRAP_PASSWORD=

# --- Network and database ---
# Host port the API is published on.
SERVER_PORT=8080
# The database is only reachable inside the compose network. Change the password.
POSTGRES_USER=vjt
POSTGRES_PASSWORD=vjt_dev_password
POSTGRES_DB=vjt

# --- Server tuning ---
# How long a login lasts, as a Go duration (default 720h = 30 days).
SESSION_TTL=720h
# Maximum request body size in bytes (default 1 MiB). Larger bodies get 413.
HTTP_MAX_BODY_BYTES=1048576

# --- Optional default AI Provider ---
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, LiteLLM, Ollama, vLLM, ...). On boot, if there is
# exactly one user and they have no providers yet, a provider named "Default" is created from these and
# assigned to every task. Base URL and model go together; the key is optional (Ollama needs none).
# A missing /v1 is added. Changing them later does not touch an existing provider: edit it in Settings.
# The container cannot reach your host's "localhost"; use a host name or address.
AI_DEFAULT_BASE_URL=
AI_DEFAULT_MODEL=
AI_DEFAULT_API_KEY=

# --- Optional MaruMori connection (key is entered in Settings) ---
# Scheduled Syncs run every MARUMORI_SYNC_INTERVAL (Go duration, default 4h, with jitter);
# MARUMORI_SYNC_ENABLED=false disables them.
MARUMORI_SYNC_INTERVAL=4h
MARUMORI_SYNC_ENABLED=true