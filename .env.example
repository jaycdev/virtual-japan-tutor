# Copy to .env and adjust. Never commit real secrets.

# Developer settings. Self-hosters use deploy/.env.example instead (see README).
# Compose in development: `docker compose --project-directory . -f deploy/docker-compose.yml -f docker-compose.dev.yml up --build`

# --- docker-compose (POSTGRES_*, SERVER_PORT, SECRETS_KEY, VJT_VERSION: same meaning as deploy/.env.example) ---
# Image version compose pulls: latest (newest release, default), dev (newest commit on main) or e.g. 1.2.3.
VJT_VERSION=latest
POSTGRES_USER=vjt
POSTGRES_PASSWORD=vjt_dev_password
POSTGRES_DB=vjt
# Host port published by the server container.
SERVER_PORT=8080
# Required by compose (also read by the server): base64 of 32 random bytes, used to encrypt
# stored secrets (e.g. the MaruMori key). Generate one with:  openssl rand -base64 32
# Losing or changing it makes already-stored secrets unreadable.
SECRETS_KEY=

# --- Server (apps/server) ---
# Listen address (default :8080).
HTTP_ADDR=:8080
# HTTP server timeouts as Go durations (e.g. 15s, 1m30s); must be positive.
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Maximum request body size in bytes, applied to every route including /auth/login (default 1 MiB).
# Larger bodies get 413.
HTTP_MAX_BODY_BYTES=1048576
# Postgres connection string (required). Compose builds its own from POSTGRES_*.
DATABASE_URL=postgres://vjt:vjt_dev_password@localhost:5432/vjt?sslmode=disable
# SECRETS_KEY (above) is also read by the server, which refuses to start without a valid one.
# How long a login session lasts, as a Go duration (default 720h = 30 days).
SESSION_TTL=720h
# Optional first-account seed: created on boot only while there are NO users (both or neither;
# password >= 10 characters). Remove the password from your .env once the account exists.
# Alternative: `server create-user --username NAME` (see README).
VJT_BOOTSTRAP_USERNAME=
VJT_BOOTSTRAP_PASSWORD=
# Optional default AI Provider: any OpenAI-compatible endpoint (OpenAI, OpenRouter, LiteLLM,
# Ollama, vLLM, ...; LAN/localhost addresses are fine). On boot, if there is exactly one user and
# they have no providers yet, a provider named "Default" is created from these and assigned to
# every task. Base URL and model go together; the key is optional (e.g. Ollama needs none).
# A missing /v1 is added. Changing them later does not touch an existing provider: edit it in
# Settings. Note the container cannot reach your host's "localhost"; use a host name or address.
AI_DEFAULT_BASE_URL=
AI_DEFAULT_MODEL=
AI_DEFAULT_API_KEY=
# Optional MaruMori connection (Settings page + scheduled Syncs). Scheduled Syncs run every
# MARUMORI_SYNC_INTERVAL (Go duration, default 4h; ±20% jitter); MARUMORI_SYNC_ENABLED=false disables them.
# MARUMORI_API_BASE_URL overrides the upstream only for stand-ins/tests (default: the public API).
MARUMORI_SYNC_INTERVAL=4h
MARUMORI_SYNC_ENABLED=true
MARUMORI_API_BASE_URL=
# Optional: enables the Postgres-backed Go tests under `go test ./...`.
TEST_DATABASE_URL=postgres://vjt:vjt_dev_password@localhost:5432/vjt?sslmode=disable

# --- Reference data import (apps/server/cmd/import; see README "Importing reference data") ---
# All optional. The import also reads DATABASE_URL above.
# Where downloads are cached (default: <user cache dir>/vjt-refdata; the compose image uses a named volume).
#REFDATA_CACHE_DIR=
# Offline mode: a directory of pre-downloaded source files laid out like the cache. Nothing is downloaded.
#REFDATA_SOURCE_DIR=
# Path of the Grammar Catalogue spreadsheet (default: data/grammar/jlpt-grammar.csv).
#GRAMMAR_CSV=

# --- Clients ---
# Web (Vite): API base URL.
VITE_API_URL=http://localhost:8080
# Mobile (Expo): API base URL. 10.0.2.2 is the host machine from the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
