# Copy to .env and adjust. Never commit real secrets.

# --- docker-compose.yml (compose reads .env automatically) ---
POSTGRES_USER=vjt
POSTGRES_PASSWORD=vjt_dev_password
POSTGRES_DB=vjt
# Host port published by the server container (on the Docker host, i.e. the remote VM).
SERVER_PORT=8080

# --- Server (apps/server) ---
# Listen address (default :8080).
HTTP_ADDR=:8080
# Postgres connection string (required). Compose builds its own from POSTGRES_*.
DATABASE_URL=postgres://vjt:vjt_dev_password@localhost:5432/vjt?sslmode=disable
# Optional: enables the Postgres-backed Go tests under `go test ./...`.
TEST_DATABASE_URL=postgres://vjt:vjt_dev_password@localhost:5432/vjt?sslmode=disable

# --- Clients ---
# Web (Vite): API base URL.
VITE_API_URL=http://localhost:8080
# Mobile (Expo): API base URL. 10.0.2.2 is the host machine from the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
